@echo off
chcp 65001 > nul
title نشر منصة الأستاذ محمد القماش على Vercel
echo ========================================================
echo   🚀 نشر منصة الأستاذ محمد القماش على سيرفر Vercel
echo ========================================================
echo.
echo [1/3] جاري تحرير ملفات البناء...
taskkill /F /IM node.exe >nul 2>&1
timeout /t 1 /nobreak >nul

echo [2/3] جاري النشر السحابي إلى حسابك في Vercel...
echo (إذا طُلب منك تسجيل الدخول، اضغط Enter وافتح المتصفح للموافقة)
echo.
cd /d "%~dp0"
call npx -y vercel --prod

echo.
echo [3/3] جاري إعادة تشغيل السيرفر المحلي...
start "" /b cmd /c "cd /d "%~dp0backend" && node src/index.js"
echo.
echo ========================================================
echo   ✅ تم النشر بنجاح! تفقد رابط المنصة أعلاه
echo ========================================================
pause
